# Optional: API base URL override.
#
# Leave this empty and the app derives the API host from the Metro dev server:
#   - iOS Simulator / web -> http://localhost:5001
#   - Android emulator    -> http://10.0.2.2:5001 (the emulator's alias for your machine)
#   - physical device     -> http://<your-machine-LAN-IP>:5001, from the Expo dev server host
#
# Set it explicitly only when the API is not on the machine running Metro, or when
# you use a tunnel (exp.direct) dev server.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
EXPO_PUBLIC_API_URL=
